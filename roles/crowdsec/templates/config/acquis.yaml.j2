# Access-Log von Traefik (/data/traefik/logs, im Container read-only gemountet)
filenames:
  - /var/log/traefik/access_traefik.log
labels:
  type: traefik
---
# AppSec (WAF): Traefik schickt jede Anfrage über das Bouncer-Plugin an diesen Port
source: appsec
listen_addr: 0.0.0.0:7422
appsec_configs:
  - crowdsecurity/appsec-default
labels:
  type: appsec
